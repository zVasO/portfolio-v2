# reCAPTCHA v3 (https://www.google.com/recaptcha/admin) — le domaine du site doit être autorisé sur la clé.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Brevo (envoi des emails du formulaire de contact)
BREVO_API_KEY=
